{
  "name": "nebulon",
  "version": "0.0.0",
  "private": true,
  "description": "NEBULON: editor y motor de videojuegos 2D basado en Phaser 4.2.1 (navegador y Android con Capacitor 8).",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "prepare:vendor": "node tools/copy-vendor.js public",
    "dev": "npm run prepare:vendor && vite",
    "build": "npm run prepare:vendor && vite build",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js",
    "test:browser": "node tests/browser/static-smoke.mjs"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
